{
  "name": "claude-marketplace-aggregator",
  "version": "0.5.0",
  "description": "An automated, open-source aggregator that discovers and curates Claude Code marketplaces and plugins from across GitHub",
  "main": "dist/index.js",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "build:production": "node scripts/build-production.js",
    "build:with-scan": "npm run scan:full && npm run build",
    "start": "next start",
    "lint": "eslint . --ext .js,.jsx,.ts,.tsx --max-warnings 266",
    "lint:fix": "eslint . --ext .js,.jsx,.ts,.tsx --fix",
    "type-check": "npx tsc --noEmit",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "test:security": "ts-node scripts/security-test.ts",
    "security:audit": "npm audit --audit-level=moderate",
    "security:check": "npm run test:security && npm run security:audit",
    "scan:marketplaces": "ts-node scripts/scan-marketplaces.ts",
    "validate:plugins": "ts-node scripts/validate-plugins.ts",
    "validate:data": "ts-node scripts/validate-generated-data.ts",
    "enrich:jev": "ts-node scripts/jev-categorize.ts",
    "generate:data": "ts-node scripts/generate-data.ts",
    "scan:full": "npm run scan:marketplaces && npm run validate:data && npm run generate:data",
    "backup": "ts-node scripts/backup-data.ts",
    "backup:create": "npm run backup backup",
    "backup:list": "npm run backup list",
    "backup:restore": "npm run backup restore",
    "maintenance:health": "curl -s https://shrwnsan.github.io/claude-marketplace-registry/data/health.json | jq .",
    "maintenance:status": "curl -s https://shrwnsan.github.io/claude-marketplace-registry/data/status.json | jq .",
    "maintenance:metrics": "curl -s https://shrwnsan.github.io/claude-marketplace-registry/data/metrics.json | jq .",
    "maintenance:analytics": "curl -s https://shrwnsan.github.io/claude-marketplace-registry/data/analytics.json | jq .",
    "maintenance:check": "npm run lint && npm run type-check && npm run test && npm run build",
    "maintenance:cleanup": "rm -rf .next node_modules/.cache && npm cache clean --force",
    "performance:test": "npm run build -- --analyze",
    "format": "prettier --write \"**/*.{ts,tsx,js,jsx,json,md,css}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,jsx,json,md,css}\"",
    "prepare": "git config core.hooksPath .husky"
  },
  "keywords": [
    "claude",
    "claude-code",
    "marketplace",
    "plugins",
    "aggregator",
    "github",
    "api"
  ],
  "author": "Claude Marketplace Aggregator Contributors",
  "license": "MIT",
  "dependencies": {
    "@octokit/rest": "20.1.2",
    "@types/dompurify": "3.2.0",
    "@typesafe-ai/sdk": "^0.6.0",
    "axios": "^1.16.0",
    "clsx": "2.1.1",
    "date-fns": "4.4.0",
    "dotenv": "18.0.0",
    "isomorphic-dompurify": "4.2.0",
    "lucide-react": "0.408.0",
    "next": "^16.2.6",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "recharts": "3.10.1",
    "tailwind-merge": "3.7.0",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.7",
    "@tailwindcss/forms": "^0.5.11",
    "@tailwindcss/typography": "^0.5.20",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/jest": "^30.0.0",
    "@types/node": "^24.0.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@typescript-eslint/eslint-plugin": "^8.70.0",
    "@typescript-eslint/parser": "^8.70.0",
    "autoprefixer": "^10.6.1",
    "eslint": "^9.39.2",
    "eslint-config-next": "^16.3.5",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.6",
    "eslint-plugin-react": "^7.34.3",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.12.0",
    "husky": "^9.1.4",
    "jest": "^30.5.2",
    "jest-environment-jsdom": "^30.5.2",
    "lint-staged": "^15.2.7",
    "postcss": "^8.5.6",
    "prettier": "^3.9.8",
    "puppeteer": "^25.11.0",
    "tailwindcss": "^3.4.18",
    "ts-jest": "^29.4.12",
    "ts-node": "^10.9.2",
    "typescript": "^5.5.3"
  },
  "engines": {
    "node": ">=24.0.0",
    "npm": ">=8.0.0"
  },
  "overrides": {
    "diff": "^8.0.3",
    "glob": "^10.4.6",
    "babel-plugin-istanbul": "^7.0.0",
    "test-exclude": "^7.0.0",
    "brace-expansion": "^2.0.3",
    "ws": "^8.21.0",
    "next": {
      "postcss": "^8.5.14"
    }
  },
  "lint-staged": {
    "*.{ts,tsx,js,jsx}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,md,css}": [
      "prettier --write"
    ]
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/shrwnsan/claude-marketplace-registry.git"
  },
  "bugs": {
    "url": "https://github.com/shrwnsan/claude-marketplace-registry/issues"
  },
  "homepage": "https://shrwnsan.github.io/claude-marketplace-registry"
}
